    def render_activity_report(self, unit_name: str, data):
        """渲染活动报告"""
        template_path = Path(__file__).parent.parent.parent / "templates" / "activity_report.txt"
        with open(template_path, 'r', encoding='utf-8') as f:
            template_content = f.read()
        
        template = Template(template_content)
        return template.render(
            unit_name=unit_name,
            service_logic=data.service_logic if data else "暂无数据",
            result_value=data.result_value if data else "暂无数据",
            generate_time=datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        )
